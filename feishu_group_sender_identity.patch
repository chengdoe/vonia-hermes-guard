+    async def _resolve_group_member_name_from_api(
+        self,
+        chat_id: Optional[str],
+        open_id: Optional[str],
+    ) -> Optional[str]:
+        """Resolve a human sender from the current chat's member roster.
+
+        This is a permission-minimizing fallback for group messages only.  It
+        never changes the stable sender IDs used for Session isolation and it
+        fails silently so a transient Feishu API error cannot block delivery.
+        """
+        if not self._client or not chat_id or not open_id:
+            return None
+        trimmed_chat_id = chat_id.strip()
+        trimmed_open_id = open_id.strip()
+        if not trimmed_chat_id or not trimmed_open_id:
+            return None
+        cached_name = self._get_cached_sender_name(trimmed_open_id)
+        if cached_name is not None:
+            return cached_name or None
+        try:
+            request = (
+                BaseRequest.builder()
+                .http_method(HttpMethod.GET)
+                .uri(f"/open-apis/im/v1/chats/{trimmed_chat_id}/members")
+                .queries([
+                    ("member_id_type", "open_id"),
+                    ("page_size", "100"),
+                ])
+                .token_types({AccessTokenType.TENANT})
+                .build()
+            )
+            response = await self._run_blocking(self._client.request, request)
+            content = getattr(getattr(response, "raw", None), "content", None)
+            if not content:
+                return None
+            payload = json.loads(content)
+            if payload.get("code") != 0:
+                return None
+            items = (payload.get("data") or {}).get("items") or []
+            for member in items:
+                member_id = str(
+                    member.get("member_id")
+                    or member.get("open_id")
+                    or ""
+                ).strip()
+                if member_id != trimmed_open_id:
+                    continue
+                name = str(member.get("name") or "").strip()
+                if not name:
+                    return None
+                self._sender_name_cache[trimmed_open_id] = (
+                    name,
+                    time.time() + _FEISHU_SENDER_NAME_TTL_SECONDS,
+                )
+                return name
+        except Exception:
+            logger.debug("[Feishu] Failed to resolve sender name from group roster", exc_info=True)
+        return None
+
